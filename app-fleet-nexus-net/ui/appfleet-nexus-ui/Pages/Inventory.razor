        _editingContactId = Guid.Empty;
        _activeContactRequest = new ContactUpsertRequest
        {
            ContactType = "Driver",
            Status = "Active",
            Phones = new List<ContactPhoneDto>
            {
                new ContactPhoneDto { PhoneNumber = "", Label = "Mobile", IsPrimary = true }
            },
            Addresses = new List<ContactAddressDto>
            {
                new ContactAddressDto { AddressLine1 = "", City = "", State = "", PostalCode = "", Label = "Home", IsPrimary = true }
            },
            Emails = new List<ContactEmailDto>()
        };
        _contactModalErrorMessage = null;
        _showContactModal = true;
    }

    private async Task EditContact(ContactSummaryDto summary)
    {
        _contactModalErrorMessage = null;
        try
        {
            var detail = await Http.GetFromJsonAsync<ContactDetailDto>($"api/contacts/{summary.Id}");
            if (detail != null)
            {
                _isEditingContact = true;
                _editingContactId = summary.Id;
                _activeContactRequest = new ContactUpsertRequest
                {
                    UniqueId = detail.UniqueId,
                    FirstName = detail.FirstName ?? "",
                    MiddleName = detail.MiddleName,
                    LastName = detail.LastName ?? "",
                    ContactType = detail.ContactType,
                    Status = detail.Status,
                    JobTitle = detail.JobTitle,
                    LicenseNumber = detail.LicenseNumber,
                    LicenseState = detail.LicenseState,
                    LicenseExpirationDate = detail.LicenseExpirationDate,
                    MedicalCertExpirationDate = detail.MedicalCertExpirationDate,
                    EmergencyContactName = detail.EmergencyContactName,
                    EmergencyContactPhone = detail.EmergencyContactPhone,
                    Notes = detail.Notes,
                    Phones = detail.Phones.Count > 0 ? detail.Phones : new List<ContactPhoneDto> { new ContactPhoneDto { PhoneNumber = "", Label = "Mobile", IsPrimary = true } },
                    Addresses = detail.Addresses.Count > 0 ? detail.Addresses : new List<ContactAddressDto> { new ContactAddressDto { AddressLine1 = "", City = "", State = "", PostalCode = "", Label = "Home", IsPrimary = true } },
                    Emails = detail.Emails ?? new List<ContactEmailDto>()
                };
                _showContactModal = true;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Could not load contact details: {ex.Message}");
        }
    }

    private void CloseContactModal()
    {
        _showContactModal = false;
        _contactModalErrorMessage = null;
    }

    private async Task HandleSaveContact(ContactUpsertRequest request)
    {
        _isSavingContact = true;
        _contactModalErrorMessage = null;

        try
        {
            HttpResponseMessage response;
            if (!_isEditingContact || _editingContactId == Guid.Empty)
            {
                response = await Http.PostAsJsonAsync("api/contacts", request);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/contacts/{_editingContactId}", request);
            }

            if (response.IsSuccessStatusCode)
            {
                _showContactModal = false;
                await LoadContactsAsync();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(errorText);
                    if (doc.RootElement.TryGetProperty("message", out var msgProp))
                    {
                        _contactModalErrorMessage = msgProp.GetString();
                    }
                    else
                    {
                        _contactModalErrorMessage = "Failed to save the contact. Please check your inputs.";
                    }
                }
                catch
                {
                    _contactModalErrorMessage = "Failed to save the contact. Please check your inputs.";
                }
            }
        }
        catch (Exception ex)
        {
            _contactModalErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSavingContact = false;
        }
    }

    private async Task DeleteContact(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this contact?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/contacts/{id}");
                if (response.IsSuccessStatusCode)
                {
                    await LoadContactsAsync();
                }
                else
                {
                    var errorText = await response.Content.ReadAsStringAsync();
                    string message = "Failed to delete contact.";
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(errorText);
                        if (doc.RootElement.TryGetProperty("message", out var msgProp))
                        {
                            message = msgProp.GetString() ?? message;
                        }
                    }
                    catch { }
                    await JSRuntime.InvokeVoidAsync("alert", message);
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"An error occurred while deleting: {ex.Message}");
            }
        }
    }
