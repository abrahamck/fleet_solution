@page "/inventory"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Inventory - FleetNexus</PageTitle>

<div class="inventory-container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-1">Inventory Management</h1>
            <p class="text-muted mb-0">Manage your company's fleet vehicles and key directory contacts.</p>
        </div>
        <div>
            @if (_activeTab == "vehicles")
            {
                <button class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2 shadow-sm" @onclick="OpenAddVehicleModal">
                    <i class="bi bi-plus-lg"></i> Add Vehicle
                </button>
            }
            else if (_activeTab == "contacts")
            {
                <button class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2 shadow-sm" @onclick="OpenAddContactModal">
                    <i class="bi bi-person-plus-fill"></i> Add Contact
                </button>
            }
        </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="inventory-tabs mb-4">
        <button class="tab-btn @(_activeTab == "vehicles" ? "active" : "")" @onclick='() => SetActiveTab("vehicles")'>
            <i class="bi bi-truck me-2"></i> Vehicles
            @if (_vehicles != null && !_isLoadingVehicles)
            {
                <span class="badge bg-secondary ms-2 bg-opacity-25 text-secondary">@_vehicles.Count</span>
            }
        </button>
        <button class="tab-btn @(_activeTab == "contacts" ? "active" : "")" @onclick='() => SetActiveTab("contacts")'>
            <i class="bi bi-people me-2"></i> Contacts
            @if (_contacts != null && !_isLoadingContacts)
            {
                <span class="badge bg-secondary ms-2 bg-opacity-25 text-secondary">@_contacts.Count</span>
            }
        </button>
    </div>

    <!-- ═══════════════════ VEHICLES TAB ═══════════════════ -->
    @if (_activeTab == "vehicles")
    {
        @if (_isLoadingVehicles)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading vehicles...</span>
                </div>
            </div>
        }
        else
        {
            <div class="inventory-content-card shadow-sm p-4 mb-4">
                <!-- Vehicle Filter Bar -->
                <div class="row g-3 mb-4 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by Unit, VIN, Plate..." 
                                   @bind="_searchQuery" @bind:event="oninput" />
                        </div>
                    </div>
                    
                    <div class="col-sm-6 col-md-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-muted small text-nowrap">Status:</label>
                            <select class="form-select" @bind="_statusFilter">
                                <option value="All">All Statuses</option>
                                <option value="Active">Active</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-muted small text-nowrap">Type:</label>
                            <select class="form-select" @bind="_typeFilter">
                                <option value="All">All Types</option>
                                <option value="Truck">Truck</option>
                                <option value="Trailer">Trailer</option>
                                <option value="Van">Van</option>
                                <option value="Sedan">Sedan</option>
                                <option value="SUV">SUV</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-auto ms-auto">
                        @if (!string.IsNullOrEmpty(_searchQuery) || _statusFilter != "All" || _typeFilter != "All")
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetVehicleFilters">
                                <i class="bi bi-x-circle me-1"></i> Reset
                            </button>
                        }
                    </div>
                </div>

                <!-- Vehicles Table -->
                @if (FilteredVehicles.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Unit #</th>
                                    <th>Make / Model</th>
                                    <th>Type</th>
                                    <th>Assigned Contact(s)</th>
                                    <th>Garage Location</th>
                                    <th>License Plate</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vehicle in FilteredVehicles)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@vehicle.UnitNumber</td>
                                        <td>
                                            <div>@(string.IsNullOrEmpty(vehicle.Make) ? "—" : $"{vehicle.Make} {vehicle.Model}")</div>
                                            <div class="text-muted extra-small">Year: @(vehicle.Year?.ToString() ?? "—")</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@(vehicle.Type ?? "General")</span></td>
                                        <td>
                                            @if (vehicle.AssignedContacts?.Any() == true)
                                            {
                                                var primary = vehicle.AssignedContacts.FirstOrDefault(c => c.IsPrimary) ?? vehicle.AssignedContacts.First();
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-circle" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                        @GetInitials(primary.ContactFullName ?? "Driver")
                                                    </div>
                                                    <div>
                                                        <span class="small fw-semibold text-dark">@(primary.ContactFullName ?? "Driver")</span>
                                                        <span class="badge bg-light text-muted border extra-small ms-1">@primary.AssociationRole</span>
                                                        @if (vehicle.AssignedContacts.Count > 1)
                                                        {
                                                            <span class="badge bg-primary bg-opacity-10 text-primary extra-small ms-1">+@(vehicle.AssignedContacts.Count - 1)</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">None</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(vehicle.PrimaryGarageAddress))
                                            {
                                                <span class="small text-truncate d-inline-block" style="max-width: 160px;" title="@vehicle.PrimaryGarageAddress">
                                                    <i class="bi bi-geo-alt text-muted me-1"></i>@vehicle.PrimaryGarageAddress
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrEmpty(vehicle.LicensePlate) ? "—" : $"{vehicle.LicensePlate} ({vehicle.LicenseState ?? "N/A"})")</td>
                                        <td>
                                            <span class="badge-status badge-@(vehicle.Status.ToLower())">
                                                @vehicle.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn-icon text-primary me-2" @onclick="() => EditVehicle(vehicle)" title="Edit Vehicle">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-icon text-danger" @onclick="() => DeleteVehicle(vehicle.Id)" title="Delete Vehicle">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Card List for Vehicles -->
                    <div class="mobile-card-list">
                        @foreach (var vehicle in FilteredVehicles)
                        {
                            <div class="vehicle-mobile-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">Unit @vehicle.UnitNumber</h5>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(vehicle.Make) ? "Vehicle" : $"{vehicle.Make} {vehicle.Model}")</span>
                                    </div>
                                    <span class="badge-status badge-@(vehicle.Status.ToLower())">
                                        @vehicle.Status
                                    </span>
                                </div>
                                <div class="d-flex gap-2 mb-2 flex-wrap">
                                    <span class="badge bg-light text-dark border small">@(vehicle.Type ?? "General")</span>
                                    @if (!string.IsNullOrEmpty(vehicle.LicensePlate))
                                    {
                                        <span class="badge bg-light text-muted border small">Plate: @vehicle.LicensePlate</span>
                                    }
                                </div>
                                @if (vehicle.AssignedContacts?.Any() == true)
                                {
                                    var primary = vehicle.AssignedContacts.FirstOrDefault(c => c.IsPrimary) ?? vehicle.AssignedContacts.First();
                                    <div class="small text-muted mb-2">
                                        <i class="bi bi-person-badge me-1"></i> Contact: <strong class="text-dark">@(primary.ContactFullName ?? "Assigned")</strong> (@primary.AssociationRole)
                                    </div>
                                }
                                <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="() => EditVehicle(vehicle)">
                                        <i class="bi bi-pencil-fill"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" @onclick="() => DeleteVehicle(vehicle.Id)">
                                        <i class="bi bi-trash3-fill"></i> Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="empty-state-icon mb-3">🔍</div>
                        <h4 class="fw-semibold text-dark">No Vehicles Found</h4>
                        <p class="text-muted max-width-400 mx-auto">We couldn't find any vehicles matching your search or filters. Adjust your criteria or add a new vehicle.</p>
                    </div>
                }
            </div>
        }
    }

    <!-- ═══════════════════ CONTACTS TAB ═══════════════════ -->
    @if (_activeTab == "contacts")
    {
        @if (_isLoadingContacts)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading contacts...</span>
                </div>
            </div>
        }
        else
        {
            <!-- KPI Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Total Contacts</div>
                            <div class="h3 fw-bold text-dark mb-0">@(_contactKpis?.TotalContacts ?? (_contacts?.Count ?? 0))</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Active Drivers</div>
                            <div class="h3 fw-bold text-dark mb-0">@(_contactKpis?.ActiveDrivers ?? 0)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div class="kpi-icon-box bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-shield-exclamation"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Expiring Licenses (30d)</div>
                            <div class="h3 fw-bold text-dark mb-0">@(_contactKpis?.LicensesExpiringIn30Days ?? 0)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contacts Directory Card -->
            <div class="inventory-content-card shadow-sm p-4 mb-4">
                <!-- Filters Bar -->
                <div class="row g-3 mb-4 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by name, ID, job..." 
                                   @bind="_contactSearchQuery" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-muted small text-nowrap">Type:</label>
                            <select class="form-select" @bind="_contactTypeFilter">
                                <option value="All">All Types</option>
                                <option value="Driver">Drivers</option>
                                <option value="FleetManager">Fleet Managers</option>
                                <option value="Vendor">Vendors</option>
                                <option value="Customer">Customers</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-muted small text-nowrap">Status:</label>
                            <select class="form-select" @bind="_contactStatusFilter">
                                <option value="All">All Statuses</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-auto ms-auto">
                        @if (!string.IsNullOrEmpty(_contactSearchQuery) || _contactTypeFilter != "All" || _contactStatusFilter != "All")
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetContactFilters">
                                <i class="bi bi-x-circle me-1"></i> Reset
                            </button>
                        }
                    </div>
                </div>

                <!-- Contacts Table -->
                @if (FilteredContacts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Contact</th>
                                    <th>Type</th>
                                    <th>Primary Phone</th>
                                    <th>Primary Email</th>
                                    <th>Primary Address</th>
                                    <th>Vehicles</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contact in FilteredContacts)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-circle">
                                                    @GetInitials(contact.FullName)
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@contact.FullName</div>
                                                    <div class="text-muted small">
                                                        @(string.IsNullOrWhiteSpace(contact.UniqueId) ? "ID: —" : $"ID: {contact.UniqueId}")
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge-type badge-type-@(contact.ContactType.ToLower())">
                                                @FormatContactType(contact.ContactType)
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(contact.PrimaryPhone))
                                            {
                                                <span class="small text-nowrap"><i class="bi bi-telephone me-1 text-muted"></i>@contact.PrimaryPhone</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(contact.PrimaryEmail))
                                            {
                                                <span class="small"><i class="bi bi-envelope me-1 text-muted"></i>@contact.PrimaryEmail</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(contact.PrimaryAddress))
                                            {
                                                <span class="small text-truncate d-inline-block" style="max-width: 180px;" title="@contact.PrimaryAddress">
                                                    <i class="bi bi-geo-alt me-1 text-muted"></i>@contact.PrimaryAddress
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-truck me-1 text-primary"></i>@contact.AssignedVehicleCount
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge-status badge-@(contact.Status.ToLower())">
                                                @contact.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn-icon text-primary me-2" @onclick="() => EditContact(contact)" title="Edit Contact">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-icon text-danger" @onclick="() => DeleteContact(contact.Id)" title="Delete Contact">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Cards List for Contacts -->
                    <div class="mobile-card-list">
                        @foreach (var contact in FilteredContacts)
                        {
                            <div class="vehicle-mobile-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle">
                                            @GetInitials(contact.FullName)
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@contact.FullName</h6>
                                            <span class="text-muted small">@FormatContactType(contact.ContactType)</span>
                                        </div>
                                    </div>
                                    <span class="badge-status badge-@(contact.Status.ToLower())">
                                        @contact.Status
                                    </span>
                                </div>
                                <div class="small text-muted mb-2">
                                    @if (!string.IsNullOrWhiteSpace(contact.PrimaryPhone))
                                    {
                                        <div><i class="bi bi-telephone me-1"></i> @contact.PrimaryPhone</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(contact.PrimaryEmail))
                                    {
                                        <div><i class="bi bi-envelope me-1"></i> @contact.PrimaryEmail</div>
                                    }
                                </div>
                                <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="() => EditContact(contact)">
                                        <i class="bi bi-pencil-fill"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" @onclick="() => DeleteContact(contact.Id)">
                                        <i class="bi bi-trash3-fill"></i> Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="empty-state-icon mb-3">🪪</div>
                        <h4 class="fw-semibold text-dark">No Contacts Found</h4>
                        <p class="text-muted max-width-400 mx-auto">We couldn't find any contacts matching your search or filters. Adjust your criteria or add a new contact.</p>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Vehicle Add/Edit Dialog Component -->
<VehicleDialog IsVisible="_showModal"
               Vehicle="_activeModel"
               AvailableContacts="_contacts"
               IsSubmitting="_isSaving"
               ErrorMessage="@_modalErrorMessage"
               OnSave="HandleSaveVehicle"
               OnCancel="CloseModal" />

<!-- Contact Add/Edit 5-Step Wizard Dialog Component -->
<ContactDialog IsVisible="_showContactModal"
               Contact="_activeContactRequest"
               IsEditMode="_isEditingContact"
               IsSubmitting="_isSavingContact"
               ErrorMessage="@_contactModalErrorMessage"
               OnSave="HandleSaveContact"
               OnCancel="CloseContactModal" />

@code {
    private string _activeTab = "vehicles";
    private bool _isLoadingVehicles = true;
    private bool _isLoadingContacts = false;
    private List<VehicleDto> _vehicles = new();
    private List<ContactSummaryDto> _contacts = new();
    private ContactKpiDto? _contactKpis;
    
    // Vehicles Filters state
    private string _searchQuery = "";
    private string _statusFilter = "All";
    private string _typeFilter = "All";

    // Contacts Filters state
    private string _contactSearchQuery = "";
    private string _contactTypeFilter = "All";
    private string _contactStatusFilter = "All";

    // Vehicle Modal state
    private bool _showModal = false;
    private bool _isSaving = false;
    private string? _modalErrorMessage;
    private VehicleDto _activeModel = new();

    // Contact Wizard Modal state
    private bool _showContactModal = false;
    private bool _isEditingContact = false;
    private Guid _editingContactId = Guid.Empty;
    private bool _isSavingContact = false;
    private string? _contactModalErrorMessage;
    private ContactUpsertRequest _activeContactRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadVehiclesAsync(), LoadContactsAsync());
    }

    private async Task SetActiveTab(string tab)
    {
        _activeTab = tab;
        if (tab == "contacts" && _contacts.Count == 0 && !_isLoadingContacts)
        {
            await LoadContactsAsync();
        }
    }

    private async Task LoadVehiclesAsync()
    {
        _isLoadingVehicles = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<VehicleDto>>("api/vehicles");
            if (response != null)
            {
                _vehicles = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading vehicles: {ex.Message}");
        }
        finally
        {
            _isLoadingVehicles = false;
        }
    }

    private async Task LoadContactsAsync()
    {
        _isLoadingContacts = true;
        try
        {
            var listTask = Http.GetFromJsonAsync<List<ContactSummaryDto>>("api/contacts");
            var kpiTask = Http.GetFromJsonAsync<ContactKpiDto>("api/contacts/summary");

            await Task.WhenAll(listTask, kpiTask);

            if (listTask.Result != null) _contacts = listTask.Result;
            if (kpiTask.Result != null) _contactKpis = kpiTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading contacts: {ex.Message}");
        }
        finally
        {
            _isLoadingContacts = false;
        }
    }

    private IEnumerable<VehicleDto> FilteredVehicles
    {
        get
        {
            return _vehicles.Where(v => 
                (string.IsNullOrEmpty(_searchQuery) || 
                 v.UnitNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 (v.Vin?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (v.Make?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (v.Model?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (v.LicensePlate?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (_statusFilter == "All" || v.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase)) &&
                (_typeFilter == "All" || (v.Type?.Equals(_typeFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            );
        }
    }

    private IEnumerable<ContactSummaryDto> FilteredContacts
    {
        get
        {
            return _contacts.Where(c =>
                (string.IsNullOrEmpty(_contactSearchQuery) ||
                 c.FullName.Contains(_contactSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                 (c.UniqueId?.Contains(_contactSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (_contactTypeFilter == "All" || (c.ContactType != null && c.ContactType.Equals(_contactTypeFilter, StringComparison.OrdinalIgnoreCase))) &&
                (_contactStatusFilter == "All" || (c.Status != null && c.Status.Equals(_contactStatusFilter, StringComparison.OrdinalIgnoreCase)))
            );
        }
    }

    private void ResetVehicleFilters()
    {
        _searchQuery = "";
        _statusFilter = "All";
        _typeFilter = "All";
    }

    private void ResetContactFilters()
    {
        _contactSearchQuery = "";
        _contactTypeFilter = "All";
        _contactStatusFilter = "All";
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "??";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string FormatContactType(string type)
    {
        return type switch
        {
            "FleetManager" => "Fleet Manager",
            _ => type
        };
    }

    // ───────────────── VEHICLE MODAL ACTIONS ─────────────────

    private async Task OpenAddVehicleModal()
    {
        if (_contacts.Count == 0)
        {
            await LoadContactsAsync();
        }

        _activeModel = new VehicleDto
        {
            AssignedContacts = new List<VehicleContactAssignmentDto>(),
            ContactAddresses = new List<ContactAddressDto>()
        };
        _modalErrorMessage = null;
        _showModal = true;
    }

    private async Task EditVehicle(VehicleDto vehicle)
    {
        if (_contacts.Count == 0)
        {
            await LoadContactsAsync();
        }

        _modalErrorMessage = null;
        try
        {
            var detail = await Http.GetFromJsonAsync<VehicleDto>($"api/vehicles/{vehicle.Id}");
            if (detail != null)
            {
                _activeModel = detail;
                _showModal = true;
            }
        }
        catch
        {
            // Fallback to shallow copy
            _activeModel = new VehicleDto
            {
                Id = vehicle.Id,
                UnitNumber = vehicle.UnitNumber,
                Vin = vehicle.Vin,
                Make = vehicle.Make,
                Model = vehicle.Model,
                Year = vehicle.Year,
                LicensePlate = vehicle.LicensePlate,
                LicenseState = vehicle.LicenseState,
                Type = vehicle.Type,
                Status = vehicle.Status,
                AssignedContacts = vehicle.AssignedContacts?.ToList() ?? new List<VehicleContactAssignmentDto>(),
                ContactAddresses = vehicle.ContactAddresses?.ToList() ?? new List<ContactAddressDto>()
            };
            _showModal = true;
        }
    }

    private void CloseModal()
    {
        _showModal = false;
        _modalErrorMessage = null;
    }

    private async Task HandleSaveVehicle(VehicleDto vehicle)
    {
        _isSaving = true;
        _modalErrorMessage = null;

        try
        {
            HttpResponseMessage response;
            if (vehicle.Id == Guid.Empty)
            {
                response = await Http.PostAsJsonAsync("api/vehicles", vehicle);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/vehicles/{vehicle.Id}", vehicle);
            }

            if (response.IsSuccessStatusCode)
            {
                _showModal = false;
                await LoadVehiclesAsync();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(errorText);
                    if (doc.RootElement.TryGetProperty("message", out var msgProp))
                    {
                         _modalErrorMessage = msgProp.GetString();
                    }
                    else
                    {
                        _modalErrorMessage = "Failed to save the vehicle. Please check inputs.";
                    }
                }
                catch
                {
                    _modalErrorMessage = "Failed to save the vehicle. Please check inputs.";
                }
            }
        }
        catch (Exception ex)
        {
            _modalErrorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteVehicle(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this vehicle from your inventory?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/vehicles/{id}");
                if (response.IsSuccessStatusCode)
                {
                    await LoadVehiclesAsync();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Failed to delete the vehicle.");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"An error occurred while deleting: {ex.Message}");
            }
        }
    }

