@using Microsoft.AspNetCore.Components.Forms
@using appfleet_nexus_ui.Models

@if (IsVisible)
{
    <div class="modal-backdrop-fade show"></div>
    <div class="modal-wrapper animate-fade-in" tabindex="-1" role="dialog">
        <div class="modal-dialog-custom modal-dialog-lg" role="document">
            <div class="modal-content-custom">
                <!-- Header -->
                <div class="modal-header-custom">
                    <div class="d-flex align-items-center">
                        <div class="modal-header-icon-box">
                            <i class="bi @(Vehicle.Id == Guid.Empty ? "bi-truck" : "bi-pencil-square")"></i>
                        </div>
                        <div>
                            <h5 class="modal-title-custom">
                                @(Vehicle.Id == Guid.Empty ? "Add Vehicle" : $"Edit Vehicle (Unit {Vehicle.UnitNumber})")
                            </h5>
                            <p class="modal-subtitle-custom">Configure vehicle specifications, driver assignments, and garage location.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" @onclick="Cancel" aria-label="Close" disabled="@IsSubmitting" title="Close dialog">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Form -->
                <EditForm Model="Vehicle" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="modal-body-custom">
                        @if (!string.IsNullOrEmpty(ErrorMessage) || !string.IsNullOrEmpty(_localError))
                        {
                            <div class="alert alert-modern alert-modern-danger mb-3 animate-fade-in" role="alert">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>@(ErrorMessage ?? _localError)</div>
                            </div>
                        }

                        <!-- Section 1: Specifications -->
                        <div class="mb-4">
                            <div class="section-header-title">
                                <i class="bi bi-truck text-primary"></i> Vehicle Specifications
                            </div>
                            <p class="section-header-desc">Enter vehicle identification, type, status, and registration details.</p>

                            <div class="row g-3">
                                <!-- Unit Number -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">Unit Number <span class="required-star">*</span></label>
                                    <InputText @bind-Value="Vehicle.UnitNumber" class="form-control-custom" placeholder="e.g. 101, TR-20" disabled="@IsSubmitting" />
                                    <ValidationMessage For="@(() => Vehicle.UnitNumber)" class="text-danger small mt-1 d-block" />
                                </div>

                                <!-- Vehicle Type -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">Type</label>
                                    <InputSelect @bind-Value="Vehicle.Type" class="form-select-custom" disabled="@IsSubmitting">
                                        <option value="">Select Type...</option>
                                        <option value="Truck">Truck</option>
                                        <option value="Trailer">Trailer</option>
                                        <option value="Van">Van</option>
                                        <option value="Sedan">Sedan</option>
                                        <option value="SUV">SUV</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Vehicle.Type)" class="text-danger small mt-1 d-block" />
                                </div>

                                <!-- Status -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">Status</label>
                                    <InputSelect @bind-Value="Vehicle.Status" class="form-select-custom" disabled="@IsSubmitting">
                                        <option value="Active">Active</option>
                                        <option value="Maintenance">Maintenance</option>
                                        <option value="Inactive">Inactive</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Vehicle.Status)" class="text-danger small mt-1 d-block" />
                                </div>

                                <!-- Make -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">Make</label>
                                    <InputText @bind-Value="Vehicle.Make" class="form-control-custom" placeholder="e.g. Ford, Freightliner" disabled="@IsSubmitting" />
                                </div>

                                <!-- Model -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">Model</label>
                                    <InputText @bind-Value="Vehicle.Model" class="form-control-custom" placeholder="e.g. Cascadia, F-250" disabled="@IsSubmitting" />
                                </div>

                                <!-- Year -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">Year</label>
                                    <InputNumber @bind-Value="Vehicle.Year" class="form-control-custom" placeholder="e.g. 2024" disabled="@IsSubmitting" />
                                    <ValidationMessage For="@(() => Vehicle.Year)" class="text-danger small mt-1 d-block" />
                                </div>

                                <!-- VIN -->
                                <div class="col-md-6">
                                    <label class="form-label-custom">VIN (17 characters)</label>
                                    <InputText @bind-Value="Vehicle.Vin" class="form-control-custom" placeholder="Enter VIN" disabled="@IsSubmitting" />
                                </div>

                                <!-- License Plate -->
                                <div class="col-md-4">
                                    <label class="form-label-custom">License Plate</label>
                                    <InputText @bind-Value="Vehicle.LicensePlate" class="form-control-custom" placeholder="e.g. TX-12345" disabled="@IsSubmitting" />
                                </div>

                                <!-- License State -->
                                <div class="col-md-2">
                                    <label class="form-label-custom">State</label>
                                    <InputText @bind-Value="Vehicle.LicenseState" class="form-control-custom" maxlength="2" placeholder="TX" disabled="@IsSubmitting" />
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Contact Assignments (Invariant I-002) -->
                        <div class="mb-4 pt-3 border-top">
                            <div class="section-header-title">
                                <i class="bi bi-people-fill text-primary"></i> Contact Assignments <span class="required-star">*</span>
                            </div>
                            <p class="section-header-desc">At least one contact must be assigned to this vehicle (Invariant I-002 / AC-011).</p>

                            <!-- Assignment Picker Card -->
                            <div class="repeatable-item-card mb-3">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label-custom">Select Contact</label>
                                        <select class="form-select-custom" @bind="_selectedContactId" disabled="@IsSubmitting">
                                            <option value="">Choose a contact...</option>
                                            @foreach (var c in AvailableContacts)
                                            {
                                                <option value="@c.Id">@c.FullName (@c.ContactType)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label-custom">Role</label>
                                        <select class="form-select-custom" @bind="_selectedRole" disabled="@IsSubmitting">
                                            <option value="Driver">Driver</option>
                                            <option value="ResponsibleContact">Responsible Contact</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-1.5 shadow-sm" @onclick="AddContactAssignment" disabled="@IsSubmitting">
                                            <i class="bi bi-person-plus"></i> Assign
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Current Assignments List -->
                            @if (Vehicle.AssignedContacts.Count > 0)
                            {
                                <div class="table-responsive border rounded-3 bg-white shadow-2xs">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3 py-2 text-muted small text-uppercase">Contact Name</th>
                                                <th class="py-2 text-muted small text-uppercase">Role</th>
                                                <th class="py-2 text-muted small text-uppercase">Primary Contact</th>
                                                <th class="text-end pe-3 py-2 text-muted small text-uppercase">Remove</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Vehicle.AssignedContacts.Count; i++)
                                            {
                                                var index = i;
                                                var assignment = Vehicle.AssignedContacts[index];
                                                <tr>
                                                    <td class="ps-3 fw-semibold text-dark">
                                                        @(assignment.ContactFullName ?? AvailableContacts.FirstOrDefault(c => c.Id == assignment.ContactId)?.FullName ?? "Assigned Contact")
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border px-2.5 py-1">@assignment.AssociationRole</span>
                                                    </td>
                                                    <td>
                                                        <label class="form-switch-custom" for="@($"vc-primary-{index}")">
                                                            <input type="checkbox" checked="@assignment.IsPrimary" @onchange="() => SetPrimaryAssignment(index)" id="@($"vc-primary-{index}")" disabled="@IsSubmitting">
                                                            <span class="small fw-semibold @(assignment.IsPrimary ? "text-primary" : "text-muted")">
                                                                @(assignment.IsPrimary ? "Primary" : "Alternate")
                                                            </span>
                                                        </label>
                                                    </td>
                                                    <td class="text-end pe-3">
                                                        <button type="button" class="btn-trash-custom ms-auto" @onclick="() => RemoveAssignment(index)" title="Remove contact" disabled="@IsSubmitting">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning-custom py-2.5 px-3 small d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                    <span>No contacts assigned yet. Please select and assign at least one contact above before saving.</span>
                                </div>
                            }
                        </div>

                        <!-- Section 3: Garage Location (Optional) -->
                        <div class="pt-3 border-top">
                            <div class="section-header-title">
                                <i class="bi bi-geo-alt-fill text-primary"></i> Primary Garage Location (Optional)
                            </div>
                            <p class="section-header-desc">Specify the primary parking depot or base garage for this vehicle.</p>

                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label-custom">Garage Street Address</label>
                                    <input type="text" class="form-control-custom" placeholder="e.g. 100 Fleet Depot Way" @bind="_garageAddressLine1" disabled="@IsSubmitting" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label-custom">City</label>
                                    <input type="text" class="form-control-custom" placeholder="City" @bind="_garageCity" disabled="@IsSubmitting" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label-custom">State</label>
                                    <input type="text" class="form-control-custom" placeholder="e.g. TX" @bind="_garageState" disabled="@IsSubmitting" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-custom">Postal Code</label>
                                    <input type="text" class="form-control-custom" placeholder="ZIP code" @bind="_garagePostalCode" disabled="@IsSubmitting" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer-custom">
                        <button type="button" class="btn btn-secondary px-4 py-2" @onclick="Cancel" disabled="@IsSubmitting">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-2 shadow-sm" disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>Save Vehicle</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public VehicleDto Vehicle { get; set; } = new();
    [Parameter] public List<ContactSummaryDto> AvailableContacts { get; set; } = new();
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback<VehicleDto> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _selectedContactId = "";
    private string _selectedRole = "Driver";
    private string? _localError;

    // Garage address fields
    private string _garageAddressLine1 = "";
    private string _garageCity = "";
    private string _garageState = "";
    private string _garagePostalCode = "";

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            _localError = null;
            if (Vehicle.AssignedContacts == null)
            {
                Vehicle.AssignedContacts = new List<VehicleContactAssignmentDto>();
            }

            // Sync garage address if already present
            var existingGarage = Vehicle.ContactAddresses?.FirstOrDefault(a => a.Label == "Garage" || a.IsPrimary);
            if (existingGarage != null)
            {
                _garageAddressLine1 = existingGarage.AddressLine1 ?? "";
                _garageCity = existingGarage.City ?? "";
                _garageState = existingGarage.State ?? "";
                _garagePostalCode = existingGarage.PostalCode ?? "";
            }
            else
            {
                _garageAddressLine1 = "";
                _garageCity = "";
                _garageState = "";
                _garagePostalCode = "";
            }
        }
    }

    private void AddContactAssignment()
    {
        _localError = null;
        if (string.IsNullOrEmpty(_selectedContactId) || !Guid.TryParse(_selectedContactId, out var contactId))
        {
            _localError = "Please select a contact from the dropdown to assign.";
            return;
        }

        if (Vehicle.AssignedContacts.Any(a => a.ContactId == contactId))
        {
            _localError = "This contact is already assigned to this vehicle.";
            return;
        }

        var contact = AvailableContacts.FirstOrDefault(c => c.Id == contactId);
        Vehicle.AssignedContacts.Add(new VehicleContactAssignmentDto
        {
            ContactId = contactId,
            ContactFullName = contact?.FullName,
            AssociationRole = _selectedRole,
            IsPrimary = Vehicle.AssignedContacts.Count == 0,
            AssignedDate = DateTime.UtcNow
        });

        _selectedContactId = "";
    }

    private void RemoveAssignment(int index)
    {
        _localError = null;
        if (index >= 0 && index < Vehicle.AssignedContacts.Count)
        {
            var wasPrimary = Vehicle.AssignedContacts[index].IsPrimary;
            Vehicle.AssignedContacts.RemoveAt(index);
            if (wasPrimary && Vehicle.AssignedContacts.Count > 0)
            {
                Vehicle.AssignedContacts[0].IsPrimary = true;
            }
        }
    }

    private void SetPrimaryAssignment(int index)
    {
        for (int i = 0; i < Vehicle.AssignedContacts.Count; i++)
        {
            Vehicle.AssignedContacts[i].IsPrimary = (i == index);
        }
    }

    private async Task Save()
    {
        _localError = null;

        // Invariant I-002: At least 1 contact must be assigned
        if (Vehicle.AssignedContacts.Count == 0)
        {
            _localError = "At least one contact must be assigned to this vehicle (Invariant I-002).";
            return;
        }

        // Ensure exactly one is primary
        if (!Vehicle.AssignedContacts.Any(a => a.IsPrimary))
        {
            Vehicle.AssignedContacts[0].IsPrimary = true;
        }

        // Update garage address if entered
        if (!string.IsNullOrWhiteSpace(_garageAddressLine1))
        {
            Vehicle.ContactAddresses = new List<ContactAddressDto>
            {
                new ContactAddressDto
                {
                    Label = "Garage",
                    IsPrimary = true,
                    AddressLine1 = _garageAddressLine1,
                    City = _garageCity,
                    State = _garageState,
                    PostalCode = _garagePostalCode,
                    Country = "USA"
                }
            };
        }

        await OnSave.InvokeAsync(Vehicle);
    }

    private async Task Cancel()
    {
        _localError = null;
        await OnCancel.InvokeAsync();
    }
}
